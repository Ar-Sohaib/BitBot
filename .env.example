# Example env for tradeBot — do NOT commit secrets to public repos.
# Copy this to `.env` and fill values as needed.

# App
APP_ENV=prod
LOG_LEVEL=INFO

# Trading pair and timeframe
SYMBOL=BTCUSDT
TIMEFRAME=1m

# Wallet / Cash
STARTING_CASH=100

# Fees & slippage
FEE_RATE=0.001
SLIPPAGE_RATE=0.0002

# Risk params
MAX_POSITION_PCT=0.2
MIN_ORDER_NOTIONAL=10
KILL_SWITCH_DRAWDOWN_PCT=0.15

# Strategy params
MA_FAST=10
MA_SLOW=30

# Data / Storage
DB_PATH=data/paper.db

# Polling / source
POLL_SECONDS=15
PRICE_SOURCE=binance

# Daily top-up
DAILY_TOPUP_ENABLED=false
DAILY_TOPUP_AMOUNT=5

# Notifications (Telegram) — leave blank to disable
TELEGRAM_ENABLE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Timezone for reports
REPORT_TZ=Europe/Paris
